# MQTT broker for the live Pantherlake feed (queue lengths + unattended-bag alerts).
#
# Copy this file to `.env` and edit the values. `.env` is gitignored; this
# example file is the one that gets committed.
#
# Vite bakes these into the JavaScript bundle at BUILD time (not at runtime),
# so after changing them you must restart `npm run dev` or rebuild. For
# Docker, pass them as build arguments.
#
# SECURITY: anything prefixed VITE_ ends up in the bundle that every visitor
# downloads, including the username and password below. They can be read by
# anyone who opens the site. Use a broker account that is read-only and limited
# to the astrikedge/<node>/# topics, never one with write or admin rights.

# Broker WebSocket URL. A browser can only speak MQTT over WebSockets, so this
# must be a ws:// or wss:// address, not the raw 1883/8883 TCP ports. Use wss://
# whenever the site itself is served over HTTPS.
# Default: HiveMQ's free public test broker (open to the whole internet).
VITE_MQTT_URL=wss://broker.hivemq.com:8884/mqtt

# Topics are  <prefix>/<node id>/<usecase>/cameras/<camera>/analytics
# Must match MQTT_PREFIX and NODE_ID in the Pantherlake server's .env.
VITE_MQTT_TOPIC_PREFIX=astrikedge
VITE_MQTT_NODE_ID=pantherlake01

# Leave blank for the public test broker. Fill in for a private broker.
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
